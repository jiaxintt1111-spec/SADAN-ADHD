    "# -*- coding: utf-8 -*-\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import classification_report, confusion_matrix, roc_curve, auc\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from tqdm import tqdm\n",
    "import os\n",
    "\n",
    "# ==========================================\n",
    "# 1. \n",
    "# ==========================================\n",
    "class EEGDataset(Dataset):\n",
    "    def __init__(self, df, channels):\n",
    "        self.data, self.labels = [], []\n",
    "        window, overlap = 512, 128\n",
    "        for _, g in df.groupby('ID'):\n",
    "            d, lbl = g[channels].values, (1 if g['Class'].iloc[0] == 'ADHD' else 0)\n",
    "            for i in range(0, len(d)-window+1, window-overlap):\n",
    "                self.data.append(d[i:i+window])\n",
    "                self.labels.append(lbl)\n",
    "    def __len__(self): return len(self.labels)\n",
    "    def __getitem__(self, i): \n",
    "        return torch.FloatTensor(self.data[i]), torch.LongTensor([self.labels[i]]).squeeze()\n",
    "\n",
    "# ==========================================\n",
    "# 2. SADAN \n",
    "# ==========================================\n",
    "class SADAN(nn.Module):\n",
    "    def __init__(self, input_dim=19):\n",
    "        super().__init__()\n",
    "        self.b7 = nn.Sequential(nn.Conv1d(input_dim, input_dim, 7, stride=4, padding=3, groups=input_dim), nn.BatchNorm1d(input_dim), nn.SiLU())\n",
    "        self.b15 = nn.Sequential(nn.Conv1d(input_dim, input_dim, 15, stride=4, padding=7, groups=input_dim), nn.BatchNorm1d(input_dim), nn.SiLU())\n",
    "        self.b31 = nn.Sequential(nn.Conv1d(input_dim, input_dim, 31, stride=4, padding=15, groups=input_dim), nn.BatchNorm1d(input_dim), nn.SiLU())\n",
    "        self.fusion = nn.Sequential(nn.Conv1d(input_dim*3, input_dim, 1), nn.BatchNorm1d(input_dim), nn.SiLU(), nn.Conv1d(input_dim, input_dim, 3, stride=2), nn.BatchNorm1d(input_dim))\n",
    "        \n",
    "        self.adaptive_pool = nn.AdaptiveAvgPool1d(63)\n",
    "        self.intra_proj = nn.Linear(63, 16)\n",
    "        \n",
    "        self.state_mapper = nn.Sequential(nn.Linear(input_dim, 32), nn.LayerNorm(32), nn.ReLU(), nn.Linear(32, 4), nn.Softmax(dim=1))\n",
    "        self.state_conv = nn.Sequential(nn.Conv1d(1, 16, 3, padding=1), nn.Flatten(), nn.Linear(16 * 4, input_dim * 16))\n",
    "        \n",
    "        self.mha = nn.MultiheadAttention(embed_dim=16, num_heads=4, batch_first=True)\n",
    "        self.classifier = nn.Sequential(nn.Linear(input_dim * 16 + input_dim, 256), nn.SiLU(), nn.Dropout(0.4), nn.Linear(256, 2))\n",
    "\n",
    "    def forward(self, x):\n",
    "        batch_size = x.size(0)\n",
    "        x_t = x.transpose(1, 2)\n",
    "        f_ms = self.fusion(torch.cat([self.b7(x_t), self.b15(x_t), self.b31(x_t)], dim=1))\n",
    "        fi = self.intra_proj(self.adaptive_pool(f_ms))\n",
    "        xn = x.mean(dim=1)\n",
    "        fs = self.state_conv(self.state_mapper(xn).unsqueeze(1)).reshape(batch_size, 19, 16)\n",
    "        attn_out, _ = self.mha(fi, fs, fi)\n",
    "        return self.classifier(torch.cat([attn_out.reshape(batch_size, -1), xn], dim=1))\n",
    "\n",
    "# ==========================================\n",
    "# 3. \n",
    "# ==========================================\n",
    "def run_sadan_pipeline():\n",
    "    # 路径配置\n",
    "    SAVE_PATH = \"/home/tjx/taijiaxinproject/new-mode-SADAN-Net/best\"\n",
    "    CSV_PATH = \"/home/tjx/taijiaxinproject/CNN-ATTENTION/public_eeg.csv\"\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    channels = ['Fp1','Fp2','F3','F4','C3','C4','P3','P4','O1','O2','F7','F8','T7','T8','P7','P8','Fz','Cz','Pz']\n",
    "    \n",
    "    df = pd.read_csv(CSV_PATH)\n",
    "    u_ids = df['ID'].unique()\n",
    "    train_ids, test_ids = train_test_split(u_ids, test_size=0.2, random_state=42)\n",
    "    \n",
    "    train_loader = DataLoader(EEGDataset(df[df['ID'].isin(train_ids)], channels), batch_size=64, shuffle=True)\n",
    "    test_loader = DataLoader(EEGDataset(df[df['ID'].isin(test_ids)], channels), batch_size=64, shuffle=False)\n",
    "    \n",
    "    
    "    model = SADAN().to(device)\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=1e-3)\n",
    "    \n",
    "    best_acc = 0.0 # \n",
    "    history = {'loss': [], 'val_acc': []}\n",
    "    \n",
    "    print(f\"🚀 run: {SAVE_PATH}\")\n",
    "    for epoch in range(30):\n",
    "        model.train()\n",
    "        total_loss = 0\n",
    "        for x, y in tqdm(train_loader, desc=f\"Epoch {epoch+1}\"):\n",
    "            optimizer.zero_grad()\n",
    "            out = model(x.to(device))\n",
    "            loss = F.cross_entropy(out, y.to(device))\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            total_loss += loss.item()\n",
    "        \n",
    "       
    "        model.eval()\n",
    "        correct, total = 0, 0\n",
    "        with torch.no_grad():\n",
    "            for vx, vy in test_loader:\n",
    "                v_out = model(vx.to(device))\n",
    "                correct += (v_out.argmax(1).cpu() == vy).sum().item()\n",
    "                total += vy.size(0)\n",
    "        \n",
    "        acc = correct / total\n",
    "        history['loss'].append(total_loss / len(train_loader))\n",
    "        history['val_acc'].append(acc)\n",
    "        \n",
    "        # ------\n",
    "        if acc > best_acc:\n",
    "            best_acc = acc\n",
    "            torch.save(model.state_dict(), SAVE_PATH)\n",
    "            print(f\"✨  Acc: {acc*100:.2f}%，save！\")\n",
    "        else:\n",
    "            print(f\"    Acc: {acc*100:.2f}% (: {best_acc*100:.2f}%)\")\n",
    "\n",
    "    print(\"\\n✅ lat_save: last_best_model.pth\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    run_sadan_pipeline()"
   ]
  }
